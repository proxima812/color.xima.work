---
import type { Locale } from "../../i18n";
import { getLocalePath, localeOptions } from "../colors/constants";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const disabledLocaleCodes = new Set<Locale>(["zh", "es", "kk", "ru", "uk"]);
const currentLocaleLabel =
	localeOptions.find((option) => option.code === locale)?.label ?? locale.toUpperCase();
---

<details class="header-locale-dropdown group relative">
	<summary
		class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-zinc-200 bg-white/90 px-3.5 py-2 text-sm font-medium text-zinc-700 transition hover:border-zinc-300 hover:bg-white"
	>
		<span
			class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-zinc-900 text-xs font-semibold text-white"
		>
			{locale.toUpperCase()}
		</span>
		<span>{currentLocaleLabel}</span>
		<svg
			class="h-4 w-4 text-zinc-400 transition group-open:rotate-180"
			viewBox="0 0 20 20"
			fill="currentColor"
			aria-hidden="true"
		>
			<path
				fill-rule="evenodd"
				d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.51a.75.75 0 0 1-1.08 0l-4.25-4.51a.75.75 0 0 1 .02-1.06Z"
				clip-rule="evenodd"></path>
		</svg>
	</summary>

	<div
		class="absolute right-0 top-[calc(100%+0.75rem)] min-w-56 overflow-hidden rounded-3xl border border-zinc-200/90 bg-white/96 p-2.5 shadow-[0_24px_50px_-30px_rgba(15,23,42,0.35)] backdrop-blur-xl"
	>
		<div class="mb-1 px-2 py-1 text-xs font-semibold text-zinc-400">Language</div>
		<div class="flex flex-col gap-1">
			{
				localeOptions.map(({ code, label }) => {
					const isDisabled = disabledLocaleCodes.has(code);
					const isCurrent = locale === code;

					return (
						<a
							href={isDisabled ? undefined : getLocalePath(code)}
							class:list={[
								"header-locale-option flex items-center justify-between rounded-2xl px-3 py-2.5 text-sm transition",
								isCurrent ? "bg-zinc-900 text-white" : "text-zinc-700 hover:bg-zinc-100/90",
								isDisabled ? "pointer-events-none opacity-45" : "",
							]}
							data-lang-link={isDisabled ? undefined : "true"}
							data-lang-btn={isDisabled ? undefined : code}
							aria-current={isCurrent ? "page" : "false"}
							aria-disabled={isDisabled ? "true" : "false"}
						>
							<span>{label}</span>
							<span class:list={["text-xs", isCurrent ? "text-zinc-300" : "text-zinc-400"]}>
								{code.toUpperCase()}
							</span>
						</a>
					);
				})
			}
		</div>
	</div>
</details>
