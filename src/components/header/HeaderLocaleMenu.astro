---
import type { Locale } from "../../i18n";
import { getLocalePath, localeOptions } from "../../data/constants";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const disabledLocaleCodes = new Set<Locale>(["zh", "es", "kk", "ru", "uk"]);
const currentLocaleLabel =
	localeOptions.find((option) => option.code === locale)?.label ?? locale.toUpperCase();
---

<details class="header-locale-dropdown group relative">
	<summary
		class="flex h-9 cursor-pointer list-none items-center gap-2 rounded-full border border-zinc-200 bg-white/90 px-3.5 text-sm font-medium text-zinc-700 transition hover:border-zinc-300 hover:bg-white hover:text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800/90 dark:text-zinc-300 dark:hover:border-zinc-600 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
	>
		<svg
			class="h-4 w-4 shrink-0 text-zinc-500 dark:text-zinc-400"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<circle cx="12" cy="12" r="10"></circle>
			<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
			<path d="M2 12h20"></path>
		</svg>
		<span class="hidden sm:inline">{currentLocaleLabel}</span>
		<span class="inline text-xs font-semibold sm:hidden">{locale.toUpperCase()}</span>
		<svg
			class="h-3.5 w-3.5 shrink-0 text-zinc-400 transition duration-200 group-open:rotate-180 dark:text-zinc-500"
			viewBox="0 0 20 20"
			fill="currentColor"
			aria-hidden="true"
		>
			<path
				fill-rule="evenodd"
				d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.51a.75.75 0 0 1-1.08 0l-4.25-4.51a.75.75 0 0 1 .02-1.06Z"
				clip-rule="evenodd"></path>
		</svg>
	</summary>

	<div
		class="absolute right-0 top-[calc(100%+0.5rem)] z-50 min-w-52 overflow-hidden rounded-2xl border border-zinc-200/80 bg-white/96 p-1.5 shadow-[0_20px_50px_-20px_rgba(15,23,42,0.3),0_0_0_1px_rgba(15,23,42,0.04)] backdrop-blur-xl dark:border-zinc-700/80 dark:bg-zinc-900/96 dark:shadow-[0_20px_50px_-20px_rgba(0,0,0,0.6),0_0_0_1px_rgba(255,255,255,0.04)]"
	>
		<div class="mb-1 px-2.5 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
			Language
		</div>
		<div class="flex flex-col gap-0.5">
			{
				localeOptions.map(({ code, label }) => {
					const isDisabled = disabledLocaleCodes.has(code);
					const isCurrent = locale === code;

					return (
						<a
							href={isDisabled ? undefined : getLocalePath(code)}
							class:list={[
								"flex items-center justify-between rounded-xl px-2.5 py-2 text-sm transition",
								isCurrent
									? "bg-zinc-900 text-white dark:bg-white dark:text-zinc-900"
									: "text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800",
								isDisabled ? "pointer-events-none opacity-40" : "cursor-pointer",
							]}
							data-lang-link={isDisabled ? undefined : "true"}
							data-lang-btn={isDisabled ? undefined : code}
							aria-current={isCurrent ? "page" : "false"}
							aria-disabled={isDisabled ? "true" : "false"}
						>
							<span>{label}</span>
							<span class="text-[11px] font-semibold text-zinc-400 dark:text-zinc-500">
								{code.toUpperCase()}
							</span>
						</a>
					);
				})
			}
		</div>
	</div>
</details>
