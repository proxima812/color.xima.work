<style>
	[data-header-shell] {
		will-change: transform, opacity, filter;
	}

	[data-header-shell][data-header-state="hidden"] {
		transform: translateY(calc(-100% - 2.25rem));
		opacity: 0;
		filter: blur(6px);
		pointer-events: none;
	}

	[data-header-shell][data-header-state="hidden"] [data-header-surface] {
		transform: scale(0.985);
		opacity: 0.92;
	}

	[data-header-shell][data-header-scrolled="true"] [data-header-surface] {
		background: rgba(255, 255, 255, 0.88);
		border-color: rgba(255, 255, 255, 0.92);
		box-shadow: 0 18px 44px -28px rgba(15, 23, 42, 0.34);
	}

	:global(.dark) [data-header-shell][data-header-scrolled="true"] [data-header-surface] {
		background: rgba(9, 9, 11, 0.9);
		border-color: rgba(63, 63, 70, 0.6);
		box-shadow: 0 18px 44px -28px rgba(0, 0, 0, 0.6);
	}
</style>

<script is:inline>
	const header = document.querySelector("[data-header-shell]");
	let lastScrollY = window.scrollY;
	let ticking = false;

	function updateHeaderVisibility() {
		if (!(header instanceof HTMLElement)) return;

		const currentScrollY = window.scrollY;
		const delta = currentScrollY - lastScrollY;
		const passedTopZone = currentScrollY > 96;
		header.dataset.headerScrolled = passedTopZone ? "true" : "false";

		if (!passedTopZone || delta < -8) {
			header.dataset.headerState = "visible";
		} else if (delta > 10) {
			header.dataset.headerState = "hidden";
		}

		lastScrollY = currentScrollY;
		ticking = false;
	}

	if (header instanceof HTMLElement) {
		header.dataset.headerState = "visible";
		header.dataset.headerScrolled = window.scrollY > 96 ? "true" : "false";
	}

	window.addEventListener(
		"scroll",
		() => {
			if (ticking) return;
			ticking = true;
			window.requestAnimationFrame(updateHeaderVisibility);
		},
		{ passive: true },
	);
</script>
