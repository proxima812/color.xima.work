---
import { Icon } from "astro-icon/components";

interface Props {
	format: "css" | "tailwind" | "scss" | "react" | "swiftui" | "flutter";
}

const { format } = Astro.props;
const className = "h-4 w-4 shrink-0";
---

{
	format === "css" && (
		<svg viewBox="0 0 512 512" class={className} aria-hidden="true" fill="none">
			<>
				<path
					fill="#264de4"
					d="M71.357 460.819 30.272 0h451.456l-41.129 460.746L255.724 512z"
				/>
				<path fill="#2965f1" d="m405.388 431.408 35.148-393.73H256v435.146z" />
				<path
					fill="#ebebeb"
					d="m124.46 208.59 5.065 56.517H256V208.59zm-5.041-57.875H256V94.197H114.281zM256 355.372l-.248.066-62.944-16.996-4.023-45.076h-56.736l7.919 88.741 115.772 32.14.26-.073z"
				/>
				<path
					fill="#fff"
					d="M255.805 208.59v56.517H325.4l-6.56 73.299-63.035 17.013v58.8l115.864-32.112.85-9.549 13.28-148.792 1.38-15.176 10.203-114.393H255.805v56.518h79.639L330.3 208.59z"
				/>
			</>
		</svg>
	)
}
{
	format === "tailwind" && (
		<svg fill="none" viewBox="0 0 54 33" class={className} aria-hidden="true">
			<>
				<g clip-path="url(#tailwindcss__a)">
					<path
						fill="#38bdf8"
						fill-rule="evenodd"
						d="M27 0c-7.2 0-11.7 3.6-13.5 10.8 2.7-3.6 5.85-4.95 9.45-4.05 2.054.513 3.522 2.004 5.147 3.653C30.744 13.09 33.808 16.2 40.5 16.2c7.2 0 11.7-3.6 13.5-10.8-2.7 3.6-5.85 4.95-9.45 4.05-2.054-.513-3.522-2.004-5.147-3.653C36.756 3.11 33.692 0 27 0zM13.5 16.2C6.3 16.2 1.8 19.8 0 27c2.7-3.6 5.85-4.95 9.45-4.05 2.054.514 3.522 2.004 5.147 3.653C17.244 29.29 20.308 32.4 27 32.4c7.2 0 11.7-3.6 13.5-10.8-2.7 3.6-5.85 4.95-9.45 4.05-2.054-.513-3.522-2.004-5.147-3.653C23.256 19.31 20.192 16.2 13.5 16.2z"
						clip-rule="evenodd"
					/>
				</g>
				<defs>
					<clipPath id="tailwindcss__a">
						<path fill="#fff" d="M0 0h54v32.4H0z" />
					</clipPath>
				</defs>
			</>
		</svg>
	)
}
{format === "scss" && <Icon name="mdi:sass" class={`${className} text-[#cd6799]`} aria-hidden="true" />}
{format === "react" && <Icon name="mdi:react" class={`${className} text-[#61dafb]`} aria-hidden="true" />}
{
	format === "swiftui" && (
		<Icon name="mdi:language-swift" class={`${className} text-[#f05138]`} aria-hidden="true" />
	)
}
{
	format === "flutter" && (
		<svg viewBox="0 0 24 24" class={className} aria-hidden="true">
			<path
				fill="#54c5f8"
				d="M14.314 0 2.3 12l3.7 3.7L21.684.013h-7.357L14.314 0zm.014 11.072L7.857 17.53l6.47 6.47H21.7l-6.46-6.468 6.46-6.46h-7.372z"
			/>
		</svg>
	)
}
