---
import type { TagId } from "@/data";

interface Props {
	tagOptions: TagId[];
	tagCounts: Partial<Record<TagId, number>>;
	tagExampleClassName?: Partial<Record<TagId, string>>;
	totalCount: number;
}

const { tagOptions, tagCounts, tagExampleClassName, totalCount } = Astro.props;

function getTagLabel(tag: TagId) {
	const map: Record<TagId, string> = {
		glow: "Glow",
		mesh: "Mesh",
		linear: "Linear",
		radial: "Radial",
		conic: "Conic",
		repeating: "Repeating",
		"multi-stop": "Multi-stop",
		transparent: "Transparent",
		border: "Border",
		noise: "Noise",
		femme: "Femme",
		masc: "Masc",
		flag: "Flags",
		other: "Other",
	};

	return map[tag];
}
---

<div class="mb-4 flex flex-wrap items-center gap-2" role="group" aria-label="Filters">
	<button
		type="button"
		class="tag-filter-btn inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-zinc-300 bg-white/70 px-3 py-1.5 text-xs text-zinc-700 transition-[background-color,border-color,color,box-shadow,transform] duration-200 hover:-translate-y-px focus-visible:-translate-y-px aria-pressed:border-zinc-900 aria-pressed:bg-zinc-900 aria-pressed:text-zinc-50 aria-pressed:shadow-[0_6px_14px_-8px_rgb(0_0_0_/_0.35)] dark:border-zinc-700 dark:bg-zinc-800/80 dark:text-zinc-400 dark:aria-pressed:border-zinc-50 dark:aria-pressed:bg-zinc-50 dark:aria-pressed:text-zinc-900"
		data-tag-filter="all"
		aria-pressed="true"
		aria-controls="colors-grid"
		aria-label={`All (${totalCount})`}
	>
		All
		<span class="tag-filter-count inline-flex h-4 min-w-4 items-center justify-center rounded-xl border border-zinc-200 bg-white px-1.5 text-[0.68rem] leading-none font-bold text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400" aria-hidden="true">{totalCount}</span>
	</button>
	{
		tagOptions.map((tag) => (
			<button
				type="button"
				class="tag-filter-btn inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-zinc-300 bg-white/70 px-3 py-1.5 text-xs text-zinc-700 transition-[background-color,border-color,color,box-shadow,transform] duration-200 hover:-translate-y-px focus-visible:-translate-y-px aria-pressed:border-zinc-900 aria-pressed:bg-zinc-900 aria-pressed:text-zinc-50 aria-pressed:shadow-[0_6px_14px_-8px_rgb(0_0_0_/_0.35)] data-[tag-filter='other']:border-gray-300 data-[tag-filter='other']:bg-gray-100/80 data-[tag-filter='other']:text-gray-700 dark:border-zinc-700 dark:bg-zinc-800/80 dark:text-zinc-400 dark:aria-pressed:border-zinc-50 dark:aria-pressed:bg-zinc-50 dark:aria-pressed:text-zinc-900 dark:data-[tag-filter='other']:border-zinc-700 dark:data-[tag-filter='other']:bg-zinc-800/60 dark:data-[tag-filter='other']:text-zinc-400"
				data-tag-filter={tag}
				aria-pressed="false"
				aria-controls="colors-grid"
				aria-label={`${getTagLabel(tag)} (${tagCounts[tag] ?? 0})`}
			>
				{tagExampleClassName?.[tag] && (
					<div
						class={`${tagExampleClassName[tag]} h-4 w-4 shrink-0 rounded-full ring-1 ring-black/5 dark:ring-white/10`}
						aria-hidden="true"
					/>
				)}
				{getTagLabel(tag)}
				<span class="tag-filter-count inline-flex h-4 min-w-4 items-center justify-center rounded-xl border border-zinc-200 bg-white px-1.5 text-[0.68rem] leading-none font-bold text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400" aria-hidden="true">{tagCounts[tag] ?? 0}</span>
			</button>
		))
	}
</div>
