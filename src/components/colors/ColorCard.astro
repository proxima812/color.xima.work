---
import { t } from "@/i18n";
import { Icon } from "astro-icon/components";

const { locale, ...card } = Astro.props;

const copyDefaultLabel = t(locale, "copyDefault");
const copyCopiedLabel = t(locale, "copyCopied");
---

<article
	class="color-card flex gap-6 items-center"
	data-color-item
	data-color-id={card.id}
	data-color-name={card.lowerName}
	data-color-tags={card.tags.join(",")}
	data-copy-active-format="css"
	role="listitem"
	aria-label={card.name}
>
	<div class="color-card-preview">
		<div class="text-zinc-500 flex justify-between items-center mb-2 dark:text-zinc-400">
			<span class="text-sm">{card.name}</span>
			<span class="text-xs">{t(locale, "idLabel")}: {card.id + 1}</span>
		</div>
		<div
			data-my-action="screen"
			class={`${card.className} rounded-3xl h-36 grid place-items-center ring-1 ring-black/5`}
			aria-hidden="true"
		>
		</div>
	</div>

	<div
		class="color-card-content text-xs md:text-sm flex justify-between gap-2 flex-col h-full py-8 items-end text-zinc-500 leading-relaxed desc-text dark:text-zinc-400"
	>
		<span>{card.description}</span>
		<div class="flex items-center gap-3 font-medium">
			<div
				class="inline-flex rounded-md border border-zinc-200 bg-white p-0.5 text-[10px] font-semibold text-zinc-500 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400"
				aria-label="Copy format"
			>
				<button
					type="button"
					class="copy-format-btn rounded px-1.5 py-1 transition"
					data-copy-format="css"
					aria-pressed="true"
				>
					CSS3
				</button>
				<button
					type="button"
					class="copy-format-btn rounded px-1.5 py-1 transition"
					data-copy-format="tailwind"
					aria-pressed="false"
				>
					TW
				</button>
			</div>
			<button
				type="button"
				class="copy-btn cursor-pointer ring-1 ring-inset ring-zinc-400/30 inline-flex gap-1.5 items-center px-3 py-2 rounded-md text-xs text-black bg-white dark:bg-zinc-800 dark:text-zinc-200 dark:ring-zinc-600/50"
				data-copy-btn
				data-copy-class={card.className}
				aria-label={`${copyDefaultLabel} CSS: ${card.name}`}
			>
				<span class="copy-btn-icon copy-btn-icon-copy" aria-hidden="true"
					><Icon name="mdi:content-copy" /></span
				>
				<span class="copy-btn-icon copy-btn-icon-check" aria-hidden="true"
					><Icon name="mdi:check-bold" /></span
				>
				<span
					class="copy-btn-label"
					data-copy-default={copyDefaultLabel}
					data-copy-copied={copyCopiedLabel}>{copyDefaultLabel}</span
				>
			</button>
		</div>
	</div>
</article>
