---
import type { CssSnippetFormats, TagId } from "@/data";
import ColorCard from "./ColorCard.astro";

interface CardItem {
	id: number;
	slug: string;
	name: string;
	lowerName: string;
	className: string;
	tags: TagId[];
	description: string;
}

interface Props {
	items: CardItem[];
	cssSnippetMap: Record<string, CssSnippetFormats>;
}

const { items, cssSnippetMap } = Astro.props;
---

<div
	id="colors-grid"
	class="grid gap-16 grid-cols-1 md:grid-cols-2"
	role="list"
>
	{items.map((card) => <ColorCard {...card} />)}
</div>

<script is:inline define:vars={{ cssSnippetMap }}>
	const root = document.getElementById("colors-gallery-root");
	const copyButtons = root?.querySelectorAll("[data-copy-btn]");
	const formatButtons = root?.querySelectorAll("[data-copy-format]");

	async function copyTextToClipboard(value) {
		try {
			await navigator.clipboard.writeText(value);
			return true;
		} catch {
			const textarea = document.createElement("textarea");
			textarea.value = value;
			textarea.style.position = "fixed";
			textarea.style.left = "-9999px";
			document.body.appendChild(textarea);
			textarea.select();
			const ok = document.execCommand("copy");
			document.body.removeChild(textarea);
			return ok;
		}
	}

	if (copyButtons?.length) {
		copyButtons.forEach((button) => {
			button.addEventListener("click", async () => {
				const className = button.getAttribute("data-copy-class");
				if (!className) return;

				const card = button.closest("[data-color-item]");
				const activeFormat = card?.getAttribute("data-copy-active-format");
				const format = activeFormat === "css" || activeFormat === "react" ? activeFormat : "tailwind";
				const value = cssSnippetMap[className]?.[format] ?? className;
				const copied = await copyTextToClipboard(value);
				if (!copied) return;

				button.setAttribute("data-copy-state", "copied");
				const labelEl = button.querySelector("[data-copy-label]");
				if (labelEl) {
					const copiedText = labelEl.getAttribute("data-copy-copied") || "Copied";
					labelEl.textContent = copiedText;
				}

				window.setTimeout(() => {
					button.removeAttribute("data-copy-state");
					if (labelEl) {
						const defaultText = labelEl.getAttribute("data-copy-default") || "Copy";
						labelEl.textContent = defaultText;
					}
				}, 1500);
			});
		});
	}

	if (formatButtons?.length) {
		formatButtons.forEach((button) => {
			button.addEventListener("click", () => {
				const card = button.closest("[data-color-item]");
				const format = button.getAttribute("data-copy-format");
				if (!card || !format) return;
				card.setAttribute("data-copy-active-format", format);
				card.querySelectorAll("[data-copy-format]").forEach((formatButton) => {
					formatButton.setAttribute(
						"aria-pressed",
						formatButton.getAttribute("data-copy-format") === format ? "true" : "false",
					);
				});
			});
		});
	}
</script>
