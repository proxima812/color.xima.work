---
import { getCollection } from "astro:content";
import { LAST_UPDATED_ISO } from "@/config";
import { buildColorCards, buildCssSnippetMap, getLastUpdatedLabel, tagOrder } from "@/data";
import ColorsControls from "./ColorsControls.astro";
import ColorsGrid from "./ColorsGrid.astro";
import ColorsHeader from "./ColorsHeader.astro";

interface Props {
	lastUpdated?: string;
	showControls?: boolean;
}

const { lastUpdated: lastUpdatedInput = LAST_UPDATED_ISO, showControls = true } = Astro.props;
const colorEntries = await getCollection("colors");

const lastUpdatedLabel = getLastUpdatedLabel(lastUpdatedInput);
const colorCards = buildColorCards(colorEntries);
const cssSnippetMap = buildCssSnippetMap(colorCards.map((card) => card.className));

const usedTags = new Set(colorCards.flatMap((card) => card.tags));
const tagOptions = tagOrder.filter((tag) => usedTags.has(tag) && tag !== "other").concat(
	usedTags.has("other") ? ["other"] : [],
);
const tagCounts = colorCards.reduce(
	(acc, card) => {
		card.tags.forEach((tag) => {
			acc[tag] = (acc[tag] ?? 0) + 1;
		});
		return acc;
	},
	{} as Partial<Record<(typeof tagOrder)[number], number>>,
);

const tagExampleClassName = tagOrder.reduce(
	(acc, tag) => {
		const matches = colorCards.filter((card) => card.tags.includes(tag));
		if (matches.length === 0) return acc;
		const representative = matches[Math.floor(matches.length / 2)];
		acc[tag] = representative.className;
		return acc;
	},
	{} as Partial<Record<(typeof tagOrder)[number], string>>,
);
---

<div id="colors-gallery-root">
	<ColorsHeader count={colorCards.length} lastUpdatedLabel={lastUpdatedLabel}>
		<slot name="after-header" />
	</ColorsHeader>
	<section>
		{
			showControls && (
				<ColorsControls
					tagOptions={tagOptions}
					tagCounts={tagCounts}
					tagExampleClassName={tagExampleClassName}
					totalCount={colorCards.length}
					searchItems={colorCards}
				/>
			)
		}
		<ColorsGrid items={colorCards} cssSnippetMap={cssSnippetMap} />
		{
			showControls && (
				<div
					class="flex flex-col items-center gap-4 rounded-xl border border-dashed border-zinc-200 bg-white/70 px-5 py-14 text-center dark:border-zinc-800 dark:bg-zinc-900/70"
					data-colors-empty
					hidden
				>
					<div class="space-y-1">
						<p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">No gradients found</p>
						<p class="text-sm text-zinc-500 dark:text-zinc-400">
							Try another word or pick a different tag.
						</p>
					</div>
					<button
						type="button"
						class="inline-flex h-9 cursor-pointer items-center rounded-xl border border-zinc-200 bg-white/70 px-3 text-sm font-medium text-zinc-600 transition hover:border-zinc-300 hover:text-zinc-950 dark:border-zinc-800 dark:bg-zinc-900/70 dark:text-zinc-400 dark:hover:border-zinc-700 dark:hover:text-zinc-50"
						data-colors-reset
					>
						Clear filters
					</button>
				</div>
			)
		}
	</section>
</div>
