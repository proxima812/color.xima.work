---
import type { Locale } from "../../i18n";
import ColorSearch from "./ColorSearch.astro";
import ColorTagFilters from "./ColorTagFilters.astro";
import type { TagId } from "../../data/tags";

interface Props {
	locale: Locale;
	tagOptions: TagId[];
	tagCounts: Partial<Record<TagId, number>>;
	totalCount: number;
}

const { locale, tagOptions, tagCounts, totalCount } = Astro.props;
---

<div class="mb-12 flex items-center gap-2">
	<!-- Sort by ID (left) -->
	<button
		type="button"
		data-sort-btn
		aria-label="Sort by ID"
		aria-pressed="false"
		class="flex h-10 shrink-0 items-center gap-1.5 rounded-full border border-zinc-200 bg-white/90 px-3.5 text-sm font-medium text-zinc-600 transition hover:border-zinc-300 hover:bg-white hover:text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800/90 dark:text-zinc-400 dark:hover:border-zinc-600 dark:hover:bg-zinc-800 dark:hover:text-zinc-200"
	>
		<span class="text-xs font-semibold">ID</span>
		<svg data-sort-icon class="h-3.5 w-3.5 transition-transform duration-200" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
			<path d="M8 2.5a.75.75 0 0 1 .75.75v8.69l2.72-2.72a.75.75 0 1 1 1.06 1.06l-4 4a.75.75 0 0 1-1.06 0l-4-4a.75.75 0 1 1 1.06-1.06L7.25 11.94V3.25A.75.75 0 0 1 8 2.5Z"/>
		</svg>
	</button>

	<!-- Search (center, grows) -->
	<div class="min-w-0 flex-1">
		<ColorSearch locale={locale} />
	</div>

	<!-- Column switcher (right) -->
	<div class="flex shrink-0 items-center rounded-full border border-zinc-200 bg-white/90 p-1 dark:border-zinc-700 dark:bg-zinc-800/90">
		<!-- 1 column -->
		<button
			type="button"
			data-cols-btn="1"
			aria-label="1 column"
			aria-pressed="false"
			class="cols-btn flex h-8 w-8 items-center justify-center rounded-full text-zinc-400 transition hover:text-zinc-700 dark:text-zinc-500 dark:hover:text-zinc-200"
		>
			<svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4" aria-hidden="true">
				<rect x="2" y="2" width="12" height="3.5" rx="1"/>
				<rect x="2" y="6.25" width="12" height="3.5" rx="1"/>
				<rect x="2" y="10.5" width="12" height="3.5" rx="1"/>
			</svg>
		</button>
		<!-- 2 columns -->
		<button
			type="button"
			data-cols-btn="2"
			aria-label="2 columns"
			aria-pressed="true"
			class="cols-btn flex h-8 w-8 items-center justify-center rounded-full text-zinc-400 transition hover:text-zinc-700 dark:text-zinc-500 dark:hover:text-zinc-200"
		>
			<svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4" aria-hidden="true">
				<rect x="2" y="2" width="5.5" height="12" rx="1"/>
				<rect x="8.5" y="2" width="5.5" height="12" rx="1"/>
			</svg>
		</button>
		<!-- 3 columns -->
		<button
			type="button"
			data-cols-btn="3"
			aria-label="3 columns"
			aria-pressed="false"
			class="cols-btn flex h-8 w-8 items-center justify-center rounded-full text-zinc-400 transition hover:text-zinc-700 dark:text-zinc-500 dark:hover:text-zinc-200"
		>
			<svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4" aria-hidden="true">
				<rect x="1" y="2" width="4" height="12" rx="1"/>
				<rect x="6" y="2" width="4" height="12" rx="1"/>
				<rect x="11" y="2" width="4" height="12" rx="1"/>
			</svg>
		</button>
	</div>
</div>

<ColorTagFilters locale={locale} tagOptions={tagOptions} tagCounts={tagCounts} totalCount={totalCount} />

<script is:inline>
	const root = document.getElementById("colors-gallery-root");
	const searchInput = root?.querySelector("[data-search-input]");
	const searchShortcutButton = root?.querySelector("[data-search-shortcut]");
	const shortcutModifier = root?.querySelector("[data-search-shortcut-mod]");
	const tagButtons = root?.querySelectorAll("[data-tag-filter]");
	const sortBtn = root?.querySelector("[data-sort-btn]");
	const sortIcon = root?.querySelector("[data-sort-icon]");
	const colsBtns = root?.querySelectorAll("[data-cols-btn]");
	const grid = document.getElementById("colors-grid");

	let activeTag = "all";
	let sortAsc = true; // true = 0→N (по умолчанию)

	// ── Search focus ──────────────────────────────────────
	function focusSearch() {
		if (!(searchInput instanceof HTMLInputElement)) return;
		searchInput.focus();
		searchInput.select();
	}

	if (shortcutModifier) {
		const isMac = /mac|iphone|ipad|ipod/i.test(navigator.platform);
		shortcutModifier.textContent = isMac ? "Cmd" : "Ctrl";
	}

	if (searchShortcutButton) {
		searchShortcutButton.addEventListener("click", focusSearch);
	}

	document.addEventListener("keydown", (event) => {
		if (event.key.toLowerCase() !== "k") return;
		if (!event.metaKey && !event.ctrlKey) return;
		const target = event.target;
		const isEditable =
			target instanceof HTMLInputElement ||
			target instanceof HTMLTextAreaElement ||
			(target instanceof HTMLElement && target.isContentEditable);
		if (isEditable && target !== searchInput) return;
		event.preventDefault();
		focusSearch();
	});

	// ── Filters ───────────────────────────────────────────
	function updateTagButtons() {
		tagButtons?.forEach((button) => {
			const tag = button.getAttribute("data-tag-filter");
			button.setAttribute("aria-pressed", tag === activeTag ? "true" : "false");
		});
	}

	function applyFilters() {
		const colorItems = root?.querySelectorAll("[data-color-item]");
		if (!colorItems?.length) return;
		const term = searchInput?.value.trim().toLowerCase() ?? "";
		colorItems.forEach((item) => {
			const searchIndex = item.getAttribute("data-color-search") ?? item.getAttribute("data-color-name") ?? "";
			const tags = (item.getAttribute("data-color-tags") ?? "").split(",").filter(Boolean);
			const searchPass = term === "" || searchIndex.includes(term);
			const tagPass = activeTag === "all" || tags.includes(activeTag);
			item.style.display = searchPass && tagPass ? "" : "none";
		});
	}

	if (searchInput) searchInput.addEventListener("input", applyFilters);

	if (tagButtons?.length) {
		tagButtons.forEach((button) => {
			button.addEventListener("click", () => {
				const tag = button.getAttribute("data-tag-filter");
				if (!tag) return;
				activeTag = tag;
				updateTagButtons();
				applyFilters();
			});
		});
	}

	// ── Sort ──────────────────────────────────────────────
	function applySort() {
		if (!grid) return;
		const items = Array.from(grid.querySelectorAll("[data-color-item]"));
		items.sort((a, b) => {
			const aId = parseInt(a.getAttribute("data-color-id") ?? "0", 10);
			const bId = parseInt(b.getAttribute("data-color-id") ?? "0", 10);
			return sortAsc ? aId - bId : bId - aId;
		});
		items.forEach((item) => grid.appendChild(item));
	}

	if (sortBtn) {
		sortBtn.addEventListener("click", () => {
			sortAsc = !sortAsc;
			sortBtn.setAttribute("aria-pressed", sortAsc ? "false" : "true");
			if (sortIcon instanceof SVGElement) {
				sortIcon.style.transform = sortAsc ? "" : "rotate(180deg)";
			}
			applySort();
		});
	}

	// ── Column switcher ───────────────────────────────────
	function setCols(cols) {
		if (!grid) return;
		grid.setAttribute("data-cols", cols);
		colsBtns?.forEach((btn) => {
			btn.setAttribute("aria-pressed", btn.getAttribute("data-cols-btn") === String(cols) ? "true" : "false");
		});
	}

	if (colsBtns?.length) {
		colsBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				const cols = btn.getAttribute("data-cols-btn");
				if (cols) setCols(cols);
			});
		});
	}

	// ── Init ──────────────────────────────────────────────
	updateTagButtons();
	applyFilters();
</script>
