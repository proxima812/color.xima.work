---
interface Props {
	count: number;
	lastUpdatedLabel: string;
}

const { count } = Astro.props;
const countText = `More than ${count} blocks of colors`;
---

<main class="mb-24">
	<h1
		class="flex items-center gap-3 text-[56px] text-zinc-900 tracking-[-1.2px] font-semibold leading-15 dark:text-zinc-50"
	>
		<!-- <Logotype /> -->
    <span>color.xima — gradients that vibe</span>
	</h1>
	<div
		class="flex md:gap-3 flex-wrap gap-1.5 items-center mt-6 text-xl text-zinc-400 md:leading-relaxed dark:text-zinc-500"
	>
		<span
			set:html={countText.replace(
				String(count),
				`<span class=\"font-semibold text-zinc-900 tracking-tighter dark:text-zinc-100\">${count}</span>`,
			)}
		/>
		<span>⦁</span>
		<span>The blocks will be updated</span>
	</div>
	<slot />
</main>
