---
import type { Locale } from "../i18n";
import GithubStarsBadge from "./colors/GithubStarsBadge.astro";
import HeaderBehavior from "./header/HeaderBehavior.astro";
import HeaderLocaleMenu from "./header/HeaderLocaleMenu.astro";
import ThemeToggle from "./header/ThemeToggle.astro";
import Logotype from "./logotype.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
---

<header
	class="px-5 mx-auto w-full max-w-5xl container header-shell sticky top-5 z-50 mb-10 translate-y-0 select-none opacity-100 transition-[transform,opacity,filter] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]"
>
	<div class="bg-white/50 dark:bg-black/50 backdrop-blur-lg px-5 py-2.5 rounded-xl">
		<div class="flex justify-between items-center">
			<div class="space-x-2 flex">
				<Logotype />
				<GithubStarsBadge owner="proxima812" repo="color.xima.work" />
			</div>
			<div class="space-x-2 flex">
				<HeaderLocaleMenu locale={locale} />
				<ThemeToggle />
			</div>
		</div>
	</div>
</header>

<HeaderBehavior />
