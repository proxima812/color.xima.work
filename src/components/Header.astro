---
import type { Locale } from "../i18n";
import HeaderBadges from "./header/HeaderBadges.astro";
import HeaderBehavior from "./header/HeaderBehavior.astro";
import HeaderLocaleMenu from "./header/HeaderLocaleMenu.astro";
import Logotype from "./logotype.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
---

<header
	class="header-shell sticky top-5 z-50 mb-10 translate-y-0 select-none opacity-100 transition-[transform,opacity,filter] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]"
>
	<div
		class="header-surface rounded-[28px] border border-white/70 bg-white/78 px-4 py-3 shadow-[0_14px_40px_-28px_rgba(15,23,42,0.28)] backdrop-blur-xl transition-[transform,box-shadow,background-color,border-color,opacity] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]"
	>
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div class="flex items-center gap-3">
				<Logotype />
				<div class="hidden sm:flex sm:items-center sm:gap-2">
					<HeaderBadges />
				</div>
			</div>

			<div class="flex items-center gap-2">
				<HeaderLocaleMenu locale={locale} />
			</div>
		</div>

		<div class="mt-3 flex items-center justify-between gap-2 sm:hidden">
			<HeaderBadges />
		</div>
	</div>
</header>

<HeaderBehavior />
