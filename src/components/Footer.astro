---
import { getCardsPath, getCollectionPath, getPickPath } from "@/config";
import { picks, tagOrder, type TagId } from "@/data";
import Logotype from "./logotype.astro";

const tagLabels: Record<TagId, string> = {
	glow: "Glow",
	mesh: "Mesh",
	linear: "Linear",
	radial: "Radial",
	conic: "Conic",
	repeating: "Repeating",
	"multi-stop": "Multi-stop",
	transparent: "Transparent",
	border: "Border",
	noise: "Noise",
	femme: "Femme",
	masc: "Masc",
	flag: "Flags",
	other: "Other",
};

const linkClass =
	"underline decoration-zinc-300 underline-offset-4 transition hover:decoration-zinc-900 dark:decoration-zinc-600 dark:hover:decoration-zinc-300";

const year = new Date().getFullYear();
---

<footer class="container mx-auto w-full max-w-5xl px-5 pb-12">
	<div class="rounded-xl border border-zinc-200 bg-white/70 p-6 dark:border-zinc-800 dark:bg-zinc-900/70 sm:p-8">
		<div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
			<div class="max-w-sm">
				<a href="/" class="inline-flex items-center gap-2 text-zinc-900 dark:text-zinc-100">
					<Logotype />
					<span class="text-sm font-semibold tracking-tight">color.xima</span>
				</a>
				<p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">
					Gradients that vibe for modern UI, cards, hero sections, copy-ready CSS, and Tailwind classes.
				</p>
			</div>
			<div class="grid grid-cols-2 gap-8 sm:grid-cols-3 sm:gap-12">
				<div>
					<h2 class="text-xs font-semibold text-zinc-900 dark:text-zinc-100">Categories</h2>
					<ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400">
						{
							tagOrder.map((tag) => (
								<li>
									<a href={getCollectionPath(tag)} class={linkClass}>
										{tagLabels[tag]}
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<div>
					<h2 class="text-xs font-semibold text-zinc-900 dark:text-zinc-100">Picks</h2>
					<ul class="mt-3 space-y-2 text-sm text-zinc-500 dark:text-zinc-400">
						{
							picks.map((pick) => (
								<li>
									<a href={getPickPath(pick.slug)} class={linkClass}>
										{pick.title}
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<div>
					<h2 class="text-xs font-semibold text-zinc-900 dark:text-zinc-100">Project</h2>
					<ul class="mt-3 space-y-2 text-sm text-zinc-500 dark:text-zinc-400">
						<li>
							<a
								href={getCardsPath()}
								class={linkClass}
							>
								All gradients
							</a>
						</li>
						<li>
							<a
								href="https://github.com/proxima812/color.xima.work"
								target="_blank"
								rel="noreferrer noopener"
								class={linkClass}
							>
								Source on GitHub
							</a>
						</li>
						<li>
							<a
								href="https://github.com/proxima812"
								target="_blank"
								rel="noreferrer noopener"
								class={linkClass}
							>
								Author
							</a>
						</li>
					</ul>
				</div>
			</div>
		</div>
		<div
			class="mt-8 border-t border-zinc-200 pt-4 text-xs text-zinc-500 dark:border-zinc-800 dark:text-zinc-400"
		>
			<span
				>Built by <a
					href="https://github.com/proxima812"
					target="_blank"
					rel="noreferrer noopener"
					class="font-medium text-zinc-900 underline decoration-zinc-300 underline-offset-4 transition hover:decoration-zinc-900 dark:text-zinc-100 dark:decoration-zinc-600 dark:hover:decoration-zinc-300"
					>proxima812</a
				></span
			>
			<span class="text-zinc-300 dark:text-zinc-600" aria-hidden="true">•</span>
			<span>&copy; {year}</span>
		</div>
	</div>
</footer>
