---
import { getCollection } from "astro:content";
import { getGeneratorInstagramPath, getGeneratorMeshPath, getGeneratorPath, getGeneratorPresetsPath } from "@/config";
import { buildColorCards } from "@/data";
import { BaseLayout } from "@/layouts";
import { Icon } from "astro-icon/components";

const cards = buildColorCards(await getCollection("colors"));
const presetSwatch = cards[0];
---

<BaseLayout
	title="Generator - color.xima"
	description="Choose a generator: pick a catalog gradient, or place your own points and build a custom mesh gradient."
	canonicalPath={getGeneratorPath()}
>
	<section class="space-y-8">
		<header class="space-y-4">
			<p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Generator</p>
			<h1 class="max-w-3xl text-5xl font-semibold leading-none tracking-tight text-zinc-950 md:text-6xl dark:text-zinc-50">
				Choose a generator
			</h1>
			<p class="max-w-2xl text-lg leading-relaxed text-zinc-500 dark:text-zinc-400">
				Start from a catalog gradient, or build your own from scratch with a mesh of color points.
			</p>
		</header>

		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			<a
				class="group flex flex-col gap-5 rounded-xl border border-zinc-200 bg-white p-5 shadow-sm shadow-zinc-950/[0.03] transition hover:border-zinc-300 dark:border-zinc-800 dark:bg-zinc-900 dark:shadow-black/10 dark:hover:border-zinc-700"
				href={getGeneratorPresetsPath()}
			>
				<div
					class={`${presetSwatch?.className ?? ""} h-28 w-full rounded-xl border border-black/5 shadow-sm dark:border-white/10`}
					aria-hidden="true"
				>
				</div>
				<div class="flex items-start justify-between gap-3">
					<div class="min-w-0 space-y-2">
						<div class="flex items-center gap-2">
							<Icon name="mdi:palette-swatch-outline" class="h-5 w-5 text-zinc-500 dark:text-zinc-400" aria-hidden="true" />
							<h2 class="text-xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">Presets</h2>
						</div>
						<p class="text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
							Pick any of the 465 catalog gradients, preview it as a block or gradient text, and copy Tailwind, CSS3, or React.
						</p>
					</div>
					<Icon
						name="mdi:arrow-right"
						class="mt-1 h-5 w-5 shrink-0 text-zinc-400 transition group-hover:translate-x-0.5 group-hover:text-zinc-950 dark:text-zinc-500 dark:group-hover:text-zinc-50"
						aria-hidden="true"
					/>
				</div>
			</a>

			<a
				class="group flex flex-col gap-5 rounded-xl border border-zinc-200 bg-white p-5 shadow-sm shadow-zinc-950/[0.03] transition hover:border-zinc-300 dark:border-zinc-800 dark:bg-zinc-900 dark:shadow-black/10 dark:hover:border-zinc-700"
				href={getGeneratorMeshPath()}
			>
				<div
					class="h-28 w-full rounded-xl border border-black/5 shadow-sm dark:border-white/10"
					style="background-color:#18181b; background-image: radial-gradient(circle at 28% 32%, #7c3aed, transparent 65%), radial-gradient(circle at 72% 68%, #22d3ee, transparent 65%), radial-gradient(circle at 50% 90%, #f472b6, transparent 60%);"
					aria-hidden="true"
				>
				</div>
				<div class="flex items-start justify-between gap-3">
					<div class="min-w-0 space-y-2">
						<div class="flex items-center gap-2">
							<Icon name="mdi:blur" class="h-5 w-5 text-zinc-500 dark:text-zinc-400" aria-hidden="true" />
							<h2 class="text-xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">Mesh</h2>
						</div>
						<p class="text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
							Place your own color points and build a custom mesh gradient from scratch.
						</p>
					</div>
					<Icon
						name="mdi:arrow-right"
						class="mt-1 h-5 w-5 shrink-0 text-zinc-400 transition group-hover:translate-x-0.5 group-hover:text-zinc-950 dark:text-zinc-500 dark:group-hover:text-zinc-50"
						aria-hidden="true"
					/>
				</div>
			</a>

			<a
				class="group flex flex-col gap-5 rounded-xl border border-zinc-200 bg-white p-5 shadow-sm shadow-zinc-950/[0.03] transition hover:border-zinc-300 dark:border-zinc-800 dark:bg-zinc-900 dark:shadow-black/10 dark:hover:border-zinc-700"
				href={getGeneratorInstagramPath()}
			>
				<div
					class="h-28 w-full overflow-hidden rounded-xl border border-black/5 bg-zinc-100 p-3 shadow-sm dark:border-white/10 dark:bg-zinc-800"
					aria-hidden="true"
				>
					<div class={`${presetSwatch?.className ?? ""} h-full w-full rounded-md`}></div>
				</div>
				<div class="flex items-start justify-between gap-3">
					<div class="min-w-0 space-y-2">
						<div class="flex items-center gap-2">
							<Icon name="mdi:image-frame" class="h-5 w-5 text-zinc-500 dark:text-zinc-400" aria-hidden="true" />
							<h2 class="text-xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">Instagram post</h2>
						</div>
						<p class="text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
							Build a gradient background sized for Instagram, frame it with padding, download as PNG.
						</p>
					</div>
					<Icon
						name="mdi:arrow-right"
						class="mt-1 h-5 w-5 shrink-0 text-zinc-400 transition group-hover:translate-x-0.5 group-hover:text-zinc-950 dark:text-zinc-500 dark:group-hover:text-zinc-50"
						aria-hidden="true"
					/>
				</div>
			</a>
		</div>
	</section>
</BaseLayout>
