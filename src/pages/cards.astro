---
import { CategoryNav, ColorsGallery } from "@/components/colors";
import { getCardsPath } from "@/config";
import { BaseLayout } from "@/layouts";

export const prerender = true;
---

<BaseLayout
	title="Gradient cards - color.xima"
	description="Browse all color.xima gradient cards in one copy-ready gallery."
	canonicalPath={getCardsPath()}
>
	<ColorsGallery showControls={false}>
		<div slot="after-header" class="mt-8">
			<CategoryNav />
		</div>
	</ColorsGallery>
</BaseLayout>
