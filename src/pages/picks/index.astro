---
import { getPickPath, getPicksPath } from "@/config";
import { picks } from "@/data";
import { BaseLayout } from "@/layouts";
import { Icon } from "astro-icon/components";
---

<BaseLayout
	title="Picks - color.xima"
	description="Hand-curated gradient collections grouped by real-world use case: hero backgrounds, card accents, buttons, dark UI, and soft pastels."
	canonicalPath={getPicksPath()}
>
	<section class="space-y-8">
		<header class="space-y-4">
			<p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Picks</p>
			<h1 class="max-w-3xl text-5xl font-semibold leading-none tracking-tight text-zinc-950 md:text-6xl dark:text-zinc-50">
				Curated collections
			</h1>
			<p class="max-w-2xl text-lg leading-relaxed text-zinc-500 dark:text-zinc-400">
				465 gradients sorted by CSS technique in the collection, and now by use case here — small, hand-picked sets for a
				specific job.
			</p>
		</header>

		<div class="grid gap-6 sm:grid-cols-2">
			{
				picks.map((pick) => (
					<a
						class="group flex flex-col gap-5 rounded-xl border border-zinc-200 bg-white p-5 shadow-sm shadow-zinc-950/[0.03] transition hover:border-zinc-300 dark:border-zinc-800 dark:bg-zinc-900 dark:shadow-black/10 dark:hover:border-zinc-700"
						href={getPickPath(pick.slug)}
					>
						<div class="grid grid-cols-4 gap-2" aria-hidden="true">
							{pick.classNames.slice(0, 4).map((className) => (
								<div class={`${className} aspect-square rounded-xl border border-black/5 shadow-sm dark:border-white/10`} />
							))}
						</div>
						<div class="flex items-start justify-between gap-3">
							<div class="min-w-0 space-y-2">
								<h2 class="text-xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">{pick.title}</h2>
								<p class="text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">{pick.description}</p>
								<p class="text-xs font-medium text-zinc-400 dark:text-zinc-500">{pick.classNames.length} gradients</p>
							</div>
							<Icon
								name="mdi:arrow-right"
								class="mt-1 h-5 w-5 shrink-0 text-zinc-400 transition group-hover:translate-x-0.5 group-hover:text-zinc-950 dark:text-zinc-500 dark:group-hover:text-zinc-50"
								aria-hidden="true"
							/>
						</div>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>
