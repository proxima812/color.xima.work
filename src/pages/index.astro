---
import ColorsGallery from "../components/colors/ColorsGallery.astro";
import { DEFAULT_LOCALE, getLocalePath } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n";

export const prerender = true;
---

<BaseLayout
	title={t(DEFAULT_LOCALE, "pageTitle")}
	description={t(DEFAULT_LOCALE, "pageDescription")}
	locale={DEFAULT_LOCALE}
	canonicalPath={getLocalePath(DEFAULT_LOCALE)}
>
	<ColorsGallery locale={DEFAULT_LOCALE} />
</BaseLayout>
